{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "web",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": ["-C", "web", "exec", "vite", "--port", "5173", "--strictPort"],
      "port": 5173
    },
    {
      "name": "webapp",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": ["-C", "webapp", "dev"],
      "port": 3000,
      "autoPort": true
    },
    {
      "name": "webapp-local-gateway",
      "runtimeExecutable": "env",
      "runtimeArgs": [
        "NEXT_PUBLIC_GATEWAY_URL=http://localhost:18080",
        "pnpm",
        "-C",
        "webapp",
        "dev"
      ],
      "port": 3000,
      "autoPort": true
    }
  ]
}
